// app/App.js
import React, { useState, useEffect, useRef } from 'react';
import { StyleSheet, SafeAreaView, ActivityIndicator, View, Text, BackHandler, Alert, TouchableOpacity } from 'react-native';
import { WebView } from 'react-native-webview';
import { useKeepAwake } from 'expo-keep-awake';
import { StatusBar } from 'expo-status-bar';
import { prepareOfflineGame } from './offlineAssets';
import { HAPTICS_INJECTED, onHaptics } from './haptics';
import SeasonMenu from './SeasonMenu';

const GAME_URL_ONLINE = 'https://mikefri-studio.github.io/frequence-zero/docs/index.html';

export default function App() {
  useKeepAwake();
  
  const [selectedSeason, setSelectedSeason] = useState(null); // 'saison1' ou 'saison2'
  const [loading, setLoading] = useState(true);
  const [source, setSource] = useState(null);
  const [canGoBack, setCanGoBack] = useState(false);
  const webviewRef = useRef(null);

  // Charger les assets de la saison sélectionnée
  useEffect(() => {
    if (!selectedSeason) return;

    (async () => {
      setLoading(true);
      try {
        // On passe la saison à la fonction (on va la mettre à jour à l'étape 3)
        const localPath = await prepareOfflineGame(selectedSeason);
        setSource({ uri: localPath });
      } catch (e) {
        console.warn("Mode hors-ligne échoué, bascule en ligne", e);
        setSource({ uri: GAME_URL_ONLINE });
      } finally {
        setLoading(false);
      }
    })();
  }, [selectedSeason]);

  // Gestion du bouton retour
  useEffect(() => {
    if (!selectedSeason) return; // Si on est dans le menu, le retour natif gère

    const onBack = () => {
      if (canGoBack && webviewRef.current) {
        webviewRef.current.goBack();
        return true;
      }
      Alert.alert(
        'Raccrocher le casque ?',
        'La ligne grésille encore… Ta progression est sauvegardée au studio.',
        [
          { text: 'Rester en antenne', style: 'cancel' },
          { 
            text: 'Quitter', 
            style: 'destructive', 
            onPress: () => {
              setSelectedSeason(null); // Retour au menu des saisons
              setSource(null);
            }
          },
        ]
      );
      return true;
    };

    BackHandler.addEventListener('hardwareBackPress', onBack);
    return () => BackHandler.removeEventListener('hardwareBackPress', onBack);
  }, [canGoBack, selectedSeason]);

  // Si aucune saison n'est choisie, afficher le menu
  if (!selectedSeason) {
    return <SeasonMenu onSelectSeason={setSelectedSeason} />;
  }

  return (
    <SafeAreaView style={styles.container}>
      <StatusBar style="light" backgroundColor="#000000" />
      
      {/* Bouton retour menu (optionnel, en plus du bouton physique Android) */}
      <TouchableOpacity 
        style={styles.backButton} 
        onPress={() => { setSelectedSeason(null); setSource(null); }}
      >
        <Text style={styles.backButtonText}>◀ MENU</Text>
      </TouchableOpacity>

      {(loading || !source) && (
        <View style={styles.loadingOverlay}>
          <Text style={styles.loadingText}>
            {selectedSeason === 'saison1' ? 'CONNEXION AU STUDIO...' : 'RECHERCHE DU SIGNAL...'}
          </Text>
          <ActivityIndicator size="large" color={selectedSeason === 'saison1' ? '#ff3333' : '#33ff33'} />
        </View>
      )}

      {source && (
        <WebView
          ref={webviewRef}
          source={source}
          style={{ flex: 1 }}
          backgroundColor="#000000"
          allowFileAccess={true}
          domStorageEnabled={true}
          javaScriptEnabled={true}
          allowsInlineMediaPlayback={true}
          mediaPlaybackRequiresUserAction={false}
          cacheEnabled={true}
          cacheMode="LOAD_DEFAULT"
          overScrollMode="never"
          pullToRefreshEnabled={false}
          setSupportMultipleWindows={false}
          injectedJavaScript={HAPTICS_INJECTED}
          onMessage={onHaptics}
          onNavigationStateChange={(nav) => setCanGoBack(nav.canGoBack)}
          onLoadEnd={() => setLoading(false)}
        />
      )}
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: '#000000' },
  backButton: { position: 'absolute', top: 50, left: 20, zIndex: 20, padding: 10 },
  backButtonText: { color: '#666', fontSize: 14, fontWeight: 'bold', letterSpacing: 2 },
  loadingOverlay: {
    position: 'absolute', top: 0, left: 0, right: 0, bottom: 0,
    justifyContent: 'center', alignItems: 'center', backgroundColor: '#000000', zIndex: 10,
  },
  loadingText: { color: '#ff3333', fontSize: 18, fontWeight: 'bold', marginBottom: 20, letterSpacing: 3 },
});